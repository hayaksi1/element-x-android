From 7046a247037e8bba0b5d07223081fc3e6856c060 Mon Sep 17 00:00:00 2001
From: hayaksi1 <193020925+hayaksi1@users.noreply.github.com>
Date: Fri, 28 Aug 2026 16:26:21 +0300
Subject: [PATCH] Drop the duplicated ClearError branch in
 ForwardMessagesPresenter

The union conflict resolution during the rebuild kept both sides of the
ForwardMessagesEvents -> ForwardMessagesEvent rename, leaving the
ClearError branch present twice. Kotlin only warns on an unreachable
when branch, so it compiled and shipped.

Behaviour is unchanged: both branches were identical. This removes the
artefact so the warning does not mask a real duplicate later.

Fork-Feature: fork-misc
---
 .../android/features/forward/impl/ForwardMessagesPresenter.kt    | 1 -
 1 file changed, 1 deletion(-)

diff --git a/features/forward/impl/src/main/kotlin/io/element/android/features/forward/impl/ForwardMessagesPresenter.kt b/features/forward/impl/src/main/kotlin/io/element/android/features/forward/impl/ForwardMessagesPresenter.kt
index 24c6ce272c..b5d50e4735 100644
--- a/features/forward/impl/src/main/kotlin/io/element/android/features/forward/impl/ForwardMessagesPresenter.kt
+++ b/features/forward/impl/src/main/kotlin/io/element/android/features/forward/impl/ForwardMessagesPresenter.kt
@@ -52,7 +52,6 @@ class ForwardMessagesPresenter(
     override fun present(): ForwardMessagesState {
         fun handleEvent(event: ForwardMessagesEvent) {
             when (event) {
-                ForwardMessagesEvent.ClearError -> forwardingActionState.value = AsyncAction.Uninitialized
                 ForwardMessagesEvent.ClearError -> forwardingActionState.value = AsyncAction.Uninitialized
                 ForwardMessagesEvent.Cancel -> {
                     forwardingJob?.cancel()
-- 
2.52.0

