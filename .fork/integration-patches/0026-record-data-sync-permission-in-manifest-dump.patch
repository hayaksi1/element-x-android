From e251af6d2de98153690a11c38b1d335701a4c35a Mon Sep 17 00:00:00 2001
From: hayaksi1 <193020925+hayaksi1@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:19:46 +0300
Subject: [PATCH] Record the data sync foreground service permission in the
 gplay manifest dump

The message search indexing sweep declares FOREGROUND_SERVICE_DATA_SYNC in
libraries/matrix/impl, so the merged app's aapt dump gains that line and the
release build's manifest check fails until the committed dump has it.

Fork-Feature: integration
---
 tools/manifest/gplay/release/aaptDump.txt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/tools/manifest/gplay/release/aaptDump.txt b/tools/manifest/gplay/release/aaptDump.txt
index 07c74e43ab..40bbbea8f2 100644
--- a/tools/manifest/gplay/release/aaptDump.txt
+++ b/tools/manifest/gplay/release/aaptDump.txt
@@ -15,6 +15,7 @@ uses-permission: name='android.permission.MODIFY_AUDIO_SETTINGS'
 uses-permission: name='android.permission.WAKE_LOCK'
 uses-permission: name='android.permission.FOREGROUND_SERVICE_MICROPHONE'
 uses-permission: name='android.permission.USE_FULL_SCREEN_INTENT'
+uses-permission: name='android.permission.FOREGROUND_SERVICE_DATA_SYNC'
 uses-permission: name='android.permission.ACCESS_NETWORK_STATE'
 uses-permission: name='android.permission.VIBRATE'
 uses-permission: name='android.permission.ACCESS_LOCAL_NETWORK'
-- 
2.52.0

